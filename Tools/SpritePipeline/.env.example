# Save the API key in the UI (Windows DPAPI), or inject PIXELLAB_API_KEY
# into the process environment for automation. Do not store a real key here.
PIXELLAB_BASE_URL=https://api.pixellab.ai

# Optional runtime tuning.
SPRITE_PIPELINE_POLL_INTERVAL_SECONDS=5
SPRITE_PIPELINE_MAX_WAIT_SECONDS=300
SPRITE_PIPELINE_HTTP_TIMEOUT_SECONDS=60
SPRITE_PIPELINE_MAX_DOWNLOAD_BYTES=20971520
